# Python bytecode and cache directories
__pycache__/
*.py[cod]
*$py.class

# Build and packaging outputs
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, lint, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local logs and database artifacts
*.log
*.sqlite
*.sqlite-journal
*.db

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Agent runtime state
.omx/
.omc/
.codex_delegate/
.codebase-memory/

# Local debug and mockup artifacts
/tmp/
/.tmp-*.png
/[0-9].png
/docs/mockups/
/tmp_probe_out.json

# Local Codex/Trellis configuration and generated acceptance artifacts
.agents/
.claude/
.codex/
artifacts/

